[Unit]
Description=Telepons Telegram bot and BuyBot indexer
Requires=telepons-migrate.service
After=network-online.target telepons-migrate.service
Wants=network-online.target

[Service]
Type=simple
User=telepons
Group=telepons
WorkingDirectory=/opt/telepons
EnvironmentFile=/etc/telepons/telepons.env
ExecStart=/usr/bin/npm run bot
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
