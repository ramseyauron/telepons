NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

APP_BASE_URL=https://telepons.bot
NEXT_PUBLIC_APP_BASE_URL=https://telepons.bot

# PostgreSQL listens only on 127.0.0.1. URL-encode the password in both URLs.
DATABASE_URL=postgresql://telepons:replace-with-url-encoded-password@127.0.0.1:5432/telepons
DATABASE_MIGRATION_URL=postgresql://telepons:replace-with-url-encoded-password@127.0.0.1:5432/telepons
DATABASE_POOL_SIZE=5

TELEGRAM_BOT_TOKEN=
TELEGRAM_LAUNCH_CHANNEL=@teleponslaunchlist
TELEGRAM_REQUIRED_CHANNELS=@teleponslaunchlist,@teleponsannouncement

ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

PINATA_JWT=
PINATA_GATEWAY=https://your-gateway.mypinata.cloud

BACKUP_DIRECTORY=/var/backups/telepons
