# REQUIRED — secret; never commit the real value.
TELEGRAM_BOT_TOKEN=

# Channel that receives announcements after a launch session is confirmed.
# The bot must be an administrator with permission to post messages.
TELEGRAM_LAUNCH_CHANNEL=@teleponslaunchlist

# REQUIRED — public URL where the signing website is reachable.
# Keep localhost for local development.
APP_BASE_URL=http://localhost:3000

# REQUIRED — native PostgreSQL connection used at runtime.
DATABASE_URL=postgresql://telepons:PASSWORD@127.0.0.1:5432/telepons
DATABASE_POOL_SIZE=5

# REQUIRED for controlled migration jobs.
DATABASE_MIGRATION_URL=postgresql://telepons:PASSWORD@127.0.0.1:5432/telepons

# Used only by the one-time SQLite importer.
SQLITE_DATABASE_PATH=./data/telepons.db

# OPTIONAL — the app defaults to Pons' documented public Robinhood Chain RPC.
# Override this with a private/fallback provider for production.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# REQUIRED in production for mobile WalletConnect/Reown support.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Public production origin used in Reown wallet metadata. It must match the
# domain allowlisted in the Reown dashboard.
NEXT_PUBLIC_APP_BASE_URL=https://telepons.family

# OPTIONAL — only needed when structured LLM extraction is enabled.
OPENAI_API_KEY=

# Structured token-detail extraction model.
OPENAI_MODEL=gpt-5.6-sol

# REQUIRED for durable public token-logo and BuyBot image storage.
# Create a scoped JWT with public file upload permission in Pinata.
PINATA_JWT=

# Your Pinata gateway, with or without the https:// prefix.
PINATA_GATEWAY=https://your-gateway.mypinata.cloud
